{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-autoport",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host=0.0.0.0"
      ],
      "port": 5173
    },
    {
      "name": "preview-closed-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port=5191",
        "--strictPort",
        "--host=0.0.0.0"
      ],
      "port": 5191
    },
    {
      "name": "preview-basement",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port=5190",
        "--strictPort",
        "--host=0.0.0.0"
      ],
      "port": 5190
    },
    {
      "name": "dist-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port=5192",
        "--strictPort",
        "--host=0.0.0.0"
      ],
      "port": 5192
    }
  ]
}
