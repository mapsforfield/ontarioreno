// OntarioReno Portal — Prisma Schema
// Prisma 7 — datasource URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  role          String   // 'admin' | 'rep' | 'contractor'
  email         String   @unique
  avatarInitial String
  avatarUrl     String?
  passwordHash  String?
  active        Boolean  @default(true)
  /// For role='contractor' accounts: the Contractor this login is scoped to
  /// (read-only, sees only that contractor's calendar + clients).
  contractorId  String?
  /// Public consultation flow may assign bookings to this user. Reps only;
  /// the flag is the lever to exclude one without a code change.
  acceptsPublicBooking Boolean @default(true)
  /// Assignment order for public bookings — LOWER goes first. Names are never
  /// hardcoded; ordering is data. Equal values fall back to a stable id sort.
  bookingPriority      Int     @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedAppointments Appointment[]        @relation("AssignedRep")
  createdAppointments  Appointment[]        @relation("CreatedBy")
  deals                Deal[]
  activities           Activity[]
  commissions          Commission[]
  dispatches           ContractorDispatch[]
  pushSubscriptions    PushSubscription[]
  clients              Client[]
  trackerRows          SaleTracker[]
  daysOff              RepDayOff[]
  salesAgreements      SalesAgreement[]
  tasks                Task[]
  leads                Lead[]
  interactions         Interaction[]
  contractPresets      ContractPreset[]
}

// ─── Contractors ─────────────────────────────────────────────────────────────

model Contractor {
  id                 String   @id @default(cuid())
  companyName        String
  contactName        String
  phone              String
  email              String
  website            String   @default("")
  logoUrl            String?
  publicCompanyName  String?
  publicPhone        String?
  publicEmail        String?
  publicWebsite      String?
  emailFooterText    String?
  financingStatus    String   @default("cash_only")
  contractorStatus   String   @default("pending")
  serviceAreas       String[]
  projectTypes       String[]
  averageProjectSize Float    @default(0)
  notes              String   @default("")
  priorityScore      Int      @default(0)
  /// Mailing address for the commission-invoice "TO" box (admin-editable).
  address            String?
  city               String?
  province           String?
  postalCode         String?
  /// Total commission rate negotiated with this contractor (admin-only —
  /// stripped from API responses for non-admins). Rep share is always 5%;
  /// admin net is everything above it. Locks into a deal's commission record
  /// at contractor-assignment time; renegotiations only affect new deals.
  commissionRate     Float    @default(0.085)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appointments Appointment[]
  deals        Deal[]
  dispatches   ContractorDispatch[]
}

// ─── Deals ───────────────────────────────────────────────────────────────────

model Deal {
  id                   String   @id @default(cuid())
  /// Optional link to the originating Client record (source of truth for contact).
  clientId             String?
  homeownerName        String
  phone                String
  email                String
  address              String   @default("")
  city                 String
  postalCode           String   @default("")
  projectType          String
  estimatedJobValue    Float    @default(0)
  financeFeePercent    Float?
  financingRequired    Boolean  @default(false)
  assignedRepId        String
  assignedContractorId String?
  status               String   @default("new_lead")
  notes                String   @default("")
  nextFollowUpDate     String   @default("")
  /// True for deals imported from before the portal existed.
  /// Historical deals are excluded from the leaderboard so they don't skew rep rankings.
  isHistorical         Boolean  @default(false)
  /// Soft-delete timestamp. Non-null means the deal is in the trash bin —
  /// excluded from all normal views, restorable, or purged permanently.
  deletedAt            DateTime?
  /// Sequential commission-invoice number, assigned once when the admin first
  /// generates the invoice for this deal (starts at 4044).
  invoiceNumber        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignedRep        User        @relation(fields: [assignedRepId], references: [id])
  assignedContractor Contractor? @relation(fields: [assignedContractorId], references: [id])
  appointments       Appointment[]
  commissions        Commission[]
  dispatches         ContractorDispatch[]
  proposals          ProposalHistory[]
  activity           DealActivity[]
  salesAgreements    SalesAgreement[]
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  note      String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// ─── Households ──────────────────────────────────────────────────────────────

model Household {
  id        String   @id @default(cuid())
  name      String
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Client[]
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Client {
  id              String    @id @default(cuid())
  name            String
  phone           String    @default("")
  email           String    @default("")
  address         String    @default("")
  city            String    @default("")
  postalCode      String    @default("")
  projectTypes    String[]
  internalNotes   String    @default("")
  source          String    @default("manual")
  householdId     String?
  /// Soft-delete timestamp — non-null means it's in the trash bin.
  deletedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  household    Household?    @relation(fields: [householdId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdByUserId], references: [id])
  appointments Appointment[]
}

// ─── Client media (videos stored in Cloudflare R2; only metadata here) ──────────

model ClientVideo {
  id               String   @id @default(cuid())
  clientId         String
  key              String   // object key in the R2 bucket
  label            String   @default("Before")
  fileName         String   @default("")
  contentType      String   @default("video/mp4")
  sizeBytes        BigInt   @default(0)
  uploadedByUserId String?
  createdAt        DateTime @default(now())
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id                       String   @id @default(cuid())
  dealId                   String?
  customerName             String
  phone                    String
  email                    String
  address                  String   @default("")
  city                     String   @default("")
  postalCode               String   @default("")
  projectType              String
  assignedRepId            String
  contractorId             String?
  appointmentDate          String
  appointmentTime          String
  durationMinutes          Int      @default(60)
  appointmentType          String   @default("home_visit")
  status                   String   @default("scheduled")
  consultationStage        String   @default("consultation_scheduled")
  location                 String   @default("")
  notes                    String   @default("")
  customerNotes            String   @default("")
  internalNotes            String   @default("")
  source                   String   @default("manual")
  title                    String?
  outcomeSubmitted         Boolean  @default(false)
  outcomeSubmittedAt       String?
  outcomeSubmittedByUserId String?
  estimatedProjectValue    Float    @default(0)
  financingNeeded          Boolean?
  homeownerInterestLevel   String?
  nextStep                 String   @default("no_action")
  recommendedContractorId  String?
  closeProbability         Float    @default(0)
  outcomeNotes             String   @default("")
  objections               String   @default("")
  followUpDate             String   @default("")
  clientId                 String?
  /// Soft-delete timestamp — non-null means it's in the trash bin.
  deletedAt                DateTime?
  /// Cached geocoded coordinates for the map/route view (Nominatim lookup,
  /// stored so we never re-geocode the same address).
  latitude                 Float?
  longitude                Float?
  /// Set when the consultation was booked from a Lead in the Sales Workspace,
  /// or by the public consultation flow.
  leadId                   String?
  /// ─── Public consultation booking ───────────────────────────────────────────
  /// Program the homeowner qualified under, pinned at booking time.
  programKey               String?
  programVersion           Int?
  /// 'HAMILTON' | 'SIMCOE'. Drives the per-rep, per-date scheduling-area lock:
  /// all of a rep's appointments on one date must share one area.
  schedulingArea           String?
  /// 'portal' | 'public_flow' — how this appointment was created.
  bookedVia                String   @default("portal")
  /// Short reference shown to the homeowner. Public bookings only.
  publicReference          String?  @unique
  externalCalendarId       String?
  externalEventId          String?
  syncedAt                 String?
  reminderMinutes          Int      @default(30)
  reminderSentAt           String?
  createdByUserId          String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedRep User        @relation("AssignedRep", fields: [assignedRepId], references: [id])
  contractor  Contractor? @relation(fields: [contractorId], references: [id])
  createdBy   User        @relation("CreatedBy", fields: [createdByUserId], references: [id])
}

// ─── Commissions ─────────────────────────────────────────────────────────────

model Commission {
  id                            String @id @default(cuid())
  dealId                        String @unique
  repId                         String
  repCommissionRate             Float
  repEstimatedCommission        Float
  repPaidCommission             Float  @default(0)
  payoutStatus                  String @default("pending")
  adminTotalCommissionRate      Float
  adminTotalEstimatedCommission Float
  adminNetCommission            Float
  // How much of the admin's net (total − rep) has actually been collected from
  // the contractor. Tracked separately from the rep payout so a deal can show
  // the rep fully paid while the admin is still owed on staggered payments.
  adminNetPaidCommission        Float   @default(0)
  // One-off flat payout not based on the % rate. When true, the total and rep
  // amounts are entered manually and NOT recomputed from job value × rate.
  customPayout                  Boolean @default(false)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  rep  User @relation(fields: [repId], references: [id])
}

// ─── Activities ──────────────────────────────────────────────────────────────

model Activity {
  id           String   @id @default(cuid())
  actorUserId  String
  actorName    String
  actorRole    String
  actionType   String
  actionLabel  String
  entityType   String
  entityId     String
  entityLabel  String
  dealId       String?
  contractorId String?
  createdAt    DateTime @default(now())
  metadata     Json?

  actor User @relation(fields: [actorUserId], references: [id])
}

// ─── Contractor Dispatches ────────────────────────────────────────────────────

model ContractorDispatch {
  id                     String   @id @default(cuid())
  consultationId         String?
  dealId                 String
  contractorId           String
  sentByUserId           String
  sentAt                 String
  status                 String   @default("draft")
  contractorResponseNote String   @default("")
  safeSummary            String   @default("")
  estimatedProjectRange  String   @default("")
  financingRequired      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  deal       Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id])
  sentBy     User       @relation(fields: [sentByUserId], references: [id])
}

// ─── Sales Tracker ───────────────────────────────────────────────────────────
// Per-rep personal deal tracker (replaces the Google Sheets each rep maintained).
// Rows can be standalone or optionally linked to a Deal in the pipeline.

model SaleTracker {
  id              String   @id @default(cuid())
  repId           String
  dealId          String?
  clientName      String
  projectTotal    Float    @default(0)
  paymentType     String   @default("")   // Finance / Cash / Finance and Cash / etc.
  city            String   @default("")
  startDate       String   @default("")   // free text: "Finished", "April", "TBD", etc.
  signingStatus   String   @default("")   // free-text notes on contract signing
  approvalStatus  String   @default("")   // "Approved 60,000", "N/A", "Pre-Approved"
  fundedStatus    String   @default("")   // "YES", "PARTIALLY", "NO"
  amountLeftToPay Float?
  notes           String   @default("")   // extra notes (extras, hold reason, etc.)
  onHold          Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rep  User  @relation(fields: [repId], references: [id])
}

// ─── Sales Agreements ────────────────────────────────────────────────────────

model SalesAgreement {
  id               String   @id @default(cuid())
  dealId           String
  fileName         String
  url              String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  deal         Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy   User @relation(fields: [uploadedByUserId], references: [id])
}

// ─── Contract Presets ─────────────────────────────────────────────────────────
// A saved starting point for the Contract Creator. Reps quote the same packages
// over and over (a legal basement suite runs to ~35 scope lines), so a preset
// captures everything that repeats — contractor, template, payment structure,
// the whole scope of work including product photos and links — and deliberately
// omits everything client-specific (name, address, contact, dates, price),
// which changes on every deal.

model ContractPreset {
  id          String   @id @default(cuid())
  name        String
  ownerUserId String
  /// Shared presets are usable by every rep; personal ones only by their owner.
  /// Only admins may publish a shared preset.
  shared      Boolean  @default(false)
  /// Denormalised for the picker, so it can label presets without a join.
  contractorId String  @default("")
  templateId   String  @default("")
  /// The reusable slice of a draft, stored as JSON.
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
}

// ─── Rep Days Off ─────────────────────────────────────────────────────────────

model RepDayOff {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  note      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─── Push Subscriptions ──────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Proposals ────────────────────────────────────────────────────────────────

model ProposalHistory {
  id              String   @id @default(cuid())
  contractorId    String
  dealId          String
  templateType    String
  proposalSubject String
  proposalBody    String
  sentAt          String
  sentByUserId    String
  createdAt       DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// ─── Settings (key/value store for admin config like the business profile) ────

model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// ─── Leads (pre-pipeline — the Google-Sheet replacement) ─────────────────────
// A Lead is a cheap, side-effect-free record (no commission/tracker spawned).
// It promotes INTO the existing Client/Deal/Appointment flow via the link
// fields below — it never duplicates those records, it points at them.

model Lead {
  id                String    @id @default(cuid())
  // Contact + qualification (from Meta / Sheet import / manual entry)
  name              String
  phone             String    @default("")
  email             String    @default("")
  city              String    @default("")
  address           String    @default("")
  postalCode        String    @default("")
  projectType       String    @default("")
  /// Free-text — Meta sends ranges like "$25k–50k", so this stays a String.
  budget            String    @default("")
  /// null = unknown
  financingInterest Boolean?
  // Provenance
  source            String    @default("manual") // 'meta' | 'import' | 'manual'
  sourceDetail      String    @default("")        // campaign / form name
  externalId        String?   @unique             // Meta leadgen id — dedupe key
  submittedAt       DateTime  @default(now())     // when the lead originated
  // Workflow
  /// 'new'|'attempting'|'callback_scheduled'|'booked'|'qualified'|'won'|'lost'|'dead'|'duplicate'
  status            String    @default("new")
  assignedRepId     String?                        // null = unassigned pool
  callbackAt        DateTime?                       // drives the queue
  lastContactedAt   DateTime?
  attemptCount      Int       @default(0)
  notes             String    @default("")
  // ─── Public consultation flow ───────────────────────────────────────────────
  /// Program resolved from the verified address, never chosen by the homeowner.
  programKey        String?
  programVersion    Int?
  schedulingArea    String?
  /// 'ADDRESS_VERIFIED' | 'ADDRESS_OUTSIDE_SERVICE_AREA' | 'ADDRESS_UNVERIFIED'
  addressState      String?
  resolvedMunicipality String?
  /// Property coordinates from Google Places, used to keep a rep's same-day
  /// visits geographically close. Null when the address wasn't verified.
  latitude          Float?
  longitude         Float?
  /// Structured qualification answers, keyed to the program's question set.
  answersJson       Json?
  /// 'DIRECT_CALENDAR' | 'MANUAL_REVIEW' | 'NURTURE' | 'DECLINE'
  routingOutcome    String?
  routingReasonCodes String[]
  /// WHY the address ended up in the state it did — see lib/address-resolution.ts.
  /// Routing ignores it; it exists so a manual review caused by OUR provider
  /// being down (PROVIDER_NOT_CONFIGURED / _QUOTA_EXHAUSTED / _ERROR) can be told
  /// apart from one caused by the address itself. Empty on every lead submitted
  /// before this column existed — those are unknown, not clean, and no backfill
  /// can recover a cause that was never computed.
  addressResolutionCause String @default("")
  /// True when the flow could not decide and a person must look.
  needsReview       Boolean   @default(false)
  /// Submissions-log worklist state. Deliberately NOT `status` / `lastContactedAt`
  /// / `attemptCount`: those are moved automatically by statusForOutcome when an
  /// interaction is logged, which would let the worklist mark itself worked
  /// without anyone deciding to. These three move only on an explicit click, and
  /// null submissionContactedAt is the single definition of "unworked".
  submissionContactedAt   DateTime?
  submissionContactedById String?
  submissionOutcomeNote   String   @default("")
  // Promotion links — Lead points at canonical records, never duplicates them
  clientId          String?
  dealId            String?
  appointmentId     String?
  // Soft-delete (trash parity with Deal/Client/Appointment)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignedRep  User?         @relation(fields: [assignedRepId], references: [id])
  interactions Interaction[]

  @@index([assignedRepId, status])
  @@index([status])
  @@index([callbackAt])
  @@index([deletedAt])
}

// ─── Interactions (multi-channel touch log — call is one channel) ────────────
// Generalized from the start so SMS/email/WhatsApp/notes/AI-summaries slot in
// without a migration. Phase 1 writes 'call', 'note', and 'system' rows.

model Interaction {
  id              String   @id @default(cuid())
  leadId          String
  userId          String?                          // actor; null for inbound/system
  /// 'call'|'sms'|'email'|'whatsapp'|'note'|'system'|'ai_summary'
  channel         String   @default("call")
  /// 'outbound'|'inbound'|'internal'
  direction       String   @default("outbound")
  outcome         String?                           // call-outcome enum; null for notes
  subject         String?                           // email subject, etc.
  body            String   @default("")             // note text / message / AI summary
  durationSeconds Int?                              // calls (null until Quo reports)
  occurredAt      DateTime @default(now())          // when it happened (may be backdated)
  metadata        Json?                             // channel extras (Quo call id, msg id)
  createdAt       DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, occurredAt])
  @@index([channel])
}

// ─── Tasks (personal to-do list per user) ────────────────────────────────────

model Task {
  id             String   @id @default(cuid())
  userId         String
  title          String
  dueAt          String?
  done           Boolean  @default(false)
  reminderSentAt String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─── Notification outbox ──────────────────────────────────────────────────────
// Booking confirmations and reminders are written in the SAME transaction as the
// appointment, then delivered after commit. That way a delivery failure can never
// lose a booking, and a retry can never double-book. Rows are the audit trail:
// what we intended to send, when, and what actually happened.

model NotificationOutbox {
  id             String   @id @default(cuid())
  appointmentId  String?
  leadId         String?
  /// 'sms' | 'email'
  channel        String
  /// 'booking_confirmation' | 'reminder_24h' | 'reminder_day_of' | 'team_alert' |
  /// 'nurture_guide' | 'lead_alert' | 'address_provider_alert'
  /// 'team_alert' fires on booking and is keyed to an appointment; 'lead_alert'
  /// fires on submission and is keyed to the lead, so non-booking outcomes are
  /// announced too.
  kind           String
  recipient      String   @default("")
  subject        String   @default("")
  body           String   @default("")
  /// Rendered HTML for email rows. Stored because delivery is deferred, so the
  /// message must survive until the drain runs. Empty for SMS.
  html           String   @default("")
  /// 'pending' | 'sent' | 'failed' | 'suppressed' | 'blocked'
  state          String   @default("pending")
  /// Why a message was not delivered — e.g. non-production environment, or a
  /// channel with no configured provider. Distinguishes "chose not to" from "broke".
  stateReason    String   @default("")
  attempts       Int      @default(0)
  lastError      String   @default("")
  /// Earliest send time, ISO. Reminders are scheduled at booking time.
  sendAfter      String
  /// Point after which the message is no longer true and must be dropped rather
  /// than sent, ISO. Empty for messages that never go stale. Reminders use it
  /// because their wording is relative — "tomorrow" is wrong once the day
  /// arrives — and the drain cannot run continuously.
  expiresAt      String   @default("")
  sentAt         String?
  /// Dedupe key so a retried drain never sends twice.
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([state, sendAfter])
  @@index([appointmentId])
}

// ─── Metered third-party spend ────────────────────────────────────────────────
// A shared daily counter for calls we are billed for, principally Google Places
// autocomplete on the public consultation form.
//
// This has to live in the database rather than in process memory. Vercel spreads
// even back-to-back requests across many instances — 25 sequential requests were
// observed hitting 14 distinct ones — so an in-memory ceiling is really that
// ceiling multiplied by the instance count, which is close to no ceiling at all.
//
// One row per API per UTC day, incremented atomically. Only genuinely billable
// calls touch it: cache hits and rejected inputs never reach here, so this adds
// a fraction of a request's worth of database traffic, not one per keystroke.

model ApiSpendCounter {
  /// "<api>:<YYYY-MM-DD>", e.g. "places_autocomplete:2026-07-27".
  id        String   @id
  /// Billable calls made against this API today.
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Grant Radar (admin-only government-program monitoring) ───────────────────
// Discovers + watches official government pages for renovation / ADU / basement
// incentive programs (e.g. Hamilton's HAF-funded ADU grant) and surfaces new or
// newly-open programs to admins before competitors catch them.
//   Municipality  = cities-first registry (HAF recipients = highest-probability).
//   GrantSource   = a specific page found for a municipality, classified by type.
//   GrantProgram  = structured program extracted from a "money" page.
// A weekly discovery job (Tavily search) finds pages per city; a daily monitor
// job re-scans known pages and re-extracts on change. All admin-only.

model Municipality {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique          // 'hamilton', 'london', 'waterloo-region'
  domain          String    @default("")     // primary official domain, e.g. 'hamilton.ca'
  jurisdiction    String    @default("ON")
  /// Housing Accelerator Fund recipient — where new homeowner grants are likeliest.
  hafRecipient    Boolean   @default(false)
  hafAmount       String    @default("")     // free-text, e.g. '$93.5M'
  /// 'candidate' (search it) | 'watching' (found future/live pages) |
  /// 'verified' (confirmed homeowner money) | 'rejected' (no program, stop searching)
  discoveryState  String    @default("candidate")
  lastDiscoveryAt DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sources GrantSource[]

  @@index([discoveryState])
  @@index([hafRecipient])
}

model GrantSource {
  id             String    @id @default(cuid())
  municipalityId String?                     // null for federal/provincial hubs
  name           String
  url            String    @unique           // dedupe discovered pages by URL
  jurisdiction   String    @default("")      // 'Hamilton' | 'Toronto' | 'ON' | 'federal'
  category       String    @default("")      // 'ADU' | 'basement' | 'energy' | 'general'
  /// LLM page classification: 'money' (live homeowner funding) | 'future'
  /// (proposed/upcoming) | 'zoning' (rules only) | 'developer' | 'news' | 'noise' | 'unknown'
  pageType       String    @default("unknown")
  discoveredVia  String    @default("")      // search query / 'seed' that surfaced it
  hafLinked      Boolean   @default(false)
  active         Boolean   @default(true)    // false = classified as noise/zoning; stop scanning
  lastCheckedAt  DateTime?
  lastHash       String    @default("")      // content hash — skip extraction if unchanged
  lastError      String    @default("")      // last fetch/parse error (surfaces dead URLs)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  municipality Municipality?  @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  programs     GrantProgram[]

  @@index([active])
  @@index([pageType])
  @@index([municipalityId])
}

model GrantProgram {
  id              String    @id @default(cuid())
  sourceId        String
  name            String
  city            String    @default("")
  jurisdiction    String    @default("")
  /// 'active' | 'upcoming' | 'closed' | 'unknown'
  status          String    @default("unknown")
  category        String    @default("")
  /// Free-text benefit as STATED by the source — never estimated. May be a cash
  /// figure/range ("$5,000–$18,000"), or a non-cash benefit ("100% DC waiver",
  /// "up to $125k low-interest loan", "development-charge deferral").
  maxAmount       String    @default("")
  /// Admin-set display value that OVERRIDES the scraped maxAmount everywhere it
  /// shows (hub table, map, cards). Survives re-scans — the scanner never writes
  /// this field. Empty = fall back to the scraped/auto-shortened amount.
  amountOverride  String    @default("")
  /// 'grant' | 'loan' | 'rebate' | 'waiver' | 'deferral' | 'tax' | 'other'
  /// Part of the merge key so a grant and a loan in the same city stay separate.
  fundingType     String    @default("")
  /// All official source URLs merged into this program (info split across pages).
  sourceUrls      Json?
  eligibility     String    @default("")
  deadline        String    @default("")
  summary         String    @default("")
  sourceUrl       String    @default("")
  relevanceScore  Int       @default(0)     // 0-100; ADU/basement + ON city ranks high
  /// 'new' | 'reviewed' | 'targeting' | 'dismissed' — drives the admin queue
  reviewState     String    @default("new")
  /// Stable dedupe key (sourceId + normalized name) so re-scans update, not dup.
  fingerprint     String    @default("")
  /// Admin-set URL the /grants hub row links to (an existing site page or a
  /// generated grant page). Empty = fall back to generated page / consultation.
  linkUrl         String    @default("")
  firstSeenAt     DateTime  @default(now())
  lastConfirmedAt DateTime  @default(now())  // last scan that still saw this program
  changedAt       DateTime?                   // last time a material field changed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source GrantSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([reviewState])
  @@index([status])
  @@index([sourceId])
}

// ─── Grant landing pages (AI-drafted, human-reviewed, published to ontarioreno.ca)
// One row per public /grants/:slug page. Generated from a GrantProgram, edited in
// the portal, then published. Rendered client-side from this record (same as the
// rest of the SPA), so no per-page code/deploy. programSnapshot lets the monitor
// flag a live page as stale when the underlying program changes.

model GrantLandingPage {
  id             String   @id @default(cuid())
  programId      String?                          // source program (null = manual)
  slug           String   @unique                 // 'hamilton-adu-grant'
  city           String   @default("")
  status         String   @default("draft")       // 'draft' | 'published'
  // Content (AI-drafted, admin-editable)
  heroEyebrow    String   @default("")            // e.g. 'Hamilton • ADU Grant'
  heroTitle      String   @default("")
  heroSubtitle   String   @default("")
  amountLabel    String   @default("")            // e.g. 'Up to $40,000'
  intro          String   @default("")
  sections       Json?                             // [{heading, body}]
  eligibility    Json?                             // string[]
  faqs           Json?                             // [{q, a}]
  ctaHeading     String   @default("")
  ctaText        String   @default("Book a free consultation")
  // SEO
  seoTitle       String   @default("")
  seoDescription String   @default("")
  // Drift detection — snapshot of the program at draft time; monitor compares.
  programSnapshot Json?                            // {status, maxAmount, deadline}
  needsReview    Boolean  @default(false)          // program changed since publish
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([programId])
}
