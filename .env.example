# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Browser OAuth client ID for Google Calendar sync.
# Required for the Broker Portal Appointment Center Google Calendar connection.
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"

# ---------------------------------------------------------------------------
# Email sending — server-side only (Vercel serverless function: api/send-email.ts)
# NEVER prefix these with VITE_ — that would expose them to the browser bundle.
# Set these in the Vercel dashboard: Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# RESEND_API_KEY: API key from resend.com. Required for transactional email sending.
# Domain info@ontarioreno.ca must be verified in the Resend dashboard (DNS TXT record).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# EMAIL_FROM: The verified sender identity used for all outgoing emails.
# Must match a domain verified in your Resend account.
EMAIL_FROM="OntarioReno <info@ontarioreno.ca>"

# CRON_SECRET: Shared secret Vercel cron uses to authorize scheduled portal jobs.
# Set this in Vercel and make sure cron requests include Authorization: Bearer <secret>.
CRON_SECRET="replace-with-a-long-random-secret"
