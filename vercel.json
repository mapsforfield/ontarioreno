{
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.png" },
    { "source": "/api/sms/inbound", "destination": "/api/appointments?resource=sms-inbound" },
    { "source": "/api/twilio", "destination": "/api/appointments?resource=twilio" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "functions": {
    "api/appointments/index.ts": { "maxDuration": 60 },
    "api/deals/index.ts": { "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/appointments?_cron=morning-brief",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/appointments?_cron=daily-recap",
      "schedule": "15 13 * * *"
    }
  ]
}
