{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/appointments?_cron=morning-brief",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/appointments?_cron=reminder-check",
      "schedule": "*/5 * * * *"
    }
  ]
}