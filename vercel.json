{
  "headers": [
    {
      "source": "/portal/consultation/:id/reschedule",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    },
    {
      "source": "/portal/consultation/:id/cancel",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.png" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/appointments/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/appointments?_cron=morning-brief",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/appointments?_cron=daily-recap",
      "schedule": "15 13 * * *"
    }
  ]
}
